# ---- Server ----
NODE_ENV=production
PORT=3000
# Number of reverse proxies in front of Node (nginx = 1). Needed for correct client IPs / rate limiting.
TRUST_PROXY=1
# auto = secure cookie only over HTTPS (works on http://localhost too). Use true once you are fully on HTTPS.
COOKIE_SECURE=auto
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_HOURS=8
SESSION_SECRET=4014f2b5c6f09675d8877bb03effe652f2a858ac6f83df2a4015cf29fd1ab5582954ae8bde022b4e73291c1a4d843f6f

# ---- Database (alwaysdata MySQL) ----
DB_HOST=65.181.111.166
DB_PORT=3306
DB_USER=theclini_shamsu557
DB_PASSWORD=@Shamsu1440
DB_NAME=theclini_dbase
DB_POOL_SIZE=10

# ---- Clinic behaviour ----
CLINIC_TIMEZONE=Africa/Lagos
DEFAULT_COUNTRY_CODE=234
# Temporary password given to NEW staff accounts (must be changed at first login)
TEMP_STAFF_PASSWORD=theclinic
MIN_BOOKING_LEAD_MINUTES=60
MAX_BOOKING_DAYS_AHEAD=60
MAX_RECEIPT_MB=5
UPLOAD_DIR=./uploads
BCRYPT_COST=12

# ---- Optional: email OTP as a 2nd factor for password recovery ----
RECOVERY_OTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="The Clinic <no-reply@yourdomain.com>"

# ---- Optional: automatic Google Meet link creation (Google Calendar API, OAuth refresh token) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# ---- Backups (scripts/backup.sh) ----
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
